POSTGRES_DB=ops_erp
POSTGRES_USER=ops_erp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 已在 infra/docker-compose.yml 开启鉴权，务必设置强口令。
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=ops-erp
# MinIO 容器根账号（infra/docker-compose.yml 使用）
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
# Plain text is used as-is. Prefix a Base64-encoded key with "base64:".
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
DATA_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRE_MINUTES=720
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUDIT_RETENTION_DAYS=365