[Unit]
Description=Engineering Ops ERP API
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=ops-erp
Group=ops-erp
WorkingDirectory=/opt/engineering-ops-erp
EnvironmentFile=/etc/ops-erp/ops-erp.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=50 -jar /opt/engineering-ops-erp/current-api.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
# 资源上限：内存上限（不设硬 MemoryMax 以免 OOM 直接 kill，配合 -XX:MaxRAMPercentage 使用）、
# CPU 份额与文件描述符上限，防止失控占满宿主。
MemoryHigh=2G
CPUQuota=200%
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/opt/engineering-ops-erp/.local-data

[Install]
WantedBy=multi-user.target
