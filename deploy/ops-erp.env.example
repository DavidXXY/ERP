# ═══════════════════════════════════════════
#  工程运维 ERP — 生产环境变量
#  路径: /etc/ops-erp/ops-erp.env
#  权限: chmod 600 ops-erp.env
# ═══════════════════════════════════════════

# ── 数据库（PostgreSQL） ──
DB_URL=jdbc:postgresql://localhost:5432/ops_erp
DB_USERNAME=ops_erp
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── 数据库容器（docker-compose 使用，必须与上面 DB_* 保持一致） ──
# DB_URL 中 jdbc:postgresql://localhost:5432/ops_erp 的库名即 POSTGRES_DB=ops_erp
POSTGRES_DB=ops_erp
POSTGRES_USER=ops_erp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ──
# Plain text is used as-is. Prefix a Base64-encoded key with "base64:".
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=https://erp.example.com
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
DATA_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
DATA_ENCRYPTION_KEY_ID=primary
# 轮换后保留旧密钥，格式：old_id=old_secret;older_id=older_secret
DATA_ENCRYPTION_PREVIOUS_KEYS=

# ── 审计保留 ──
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_BATCH_SIZE=1000
AUDIT_CLEANUP_MAX_BATCHES=20

# ── 微信小程序登录（启用前填写正式小程序凭证） ──
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 首次启动管理员（只在账号不存在时创建，之后不会覆盖密码） ──
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# ── 对象存储（MinIO / S3 兼容） ──
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ops_erp_minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=ops-erp
MINIO_PRESIGNED_EXPIRY_SECONDS=600
# MinIO 容器根账号（docker-compose 使用，必须与 MINIO_ACCESS_KEY / MINIO_SECRET_KEY 保持一致）
MINIO_ROOT_USER=ops_erp_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ── 通知与邮件（SMTP 未启用时供应商门户密码重置验证码不回传） ──
SMTP_ENABLED=false
SMTP_FROM=ops-erp@localhost
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_DISPATCH_INTERVAL_MS=60000
SUPPLIER_PORTAL_URL=https://supplier.erp.example.com

# ── 维护计划生成调度 ──
MAINTENANCE_PLAN_GENERATION_CRON=0 5 1 * * *

# ── 加密备份（age 公钥与恢复私钥文件） ──
BACKUP_ENCRYPTION_RECIPIENT=age1REPLACE_WITH_OFFLINE_RECIPIENT
BACKUP_ENCRYPTION_IDENTITY=/etc/ops-erp/backup-age-identity.txt
BACKUP_RETENTION_DAYS=30
OPS_STATUS_DIR=/var/backups/ops-erp/.status
# 可选 rclone 远端，例如 s3-dr:ops-erp-backups；留空则不异地复制
BACKUP_OFFSITE_REMOTE=

# 可选：备份同时打包配置（默认 auto 仅打包存在的路径）
# BACKUP_CONFIG=auto
# BACKUP_CONFIG_PATHS="/etc/ops-erp /etc/nginx/sites-available/ops-erp /etc/nginx/sites-available/ops-erp-ports /etc/nginx/snippets/ops-erp-common.conf /etc/nginx/snippets/ops-erp-proxy.conf /etc/systemd/system/ops-erp-api.service /etc/systemd/system/ops-erp-backup.service /etc/systemd/system/ops-erp-backup.timer /etc/systemd/system/ops-erp-restore-drill.service /etc/systemd/system/ops-erp-restore-drill.timer"
# 恢复演练可选：把对象存储恢复到独立的演练桶（而非生产桶）
# RESTORE_DRILL_OBJECTS_BUCKET=ops_erp_restore_drill

# 历史资质数据默认禁用。仅在受控迁移窗口中指向服务器本地、非 Web 目录的清单。
QUALIFICATION_IMPORT_ENABLED=false
QUALIFICATION_IMPORT_FILE=

# ── Spring Profile（固定为 prod） ──
SPRING_PROFILES_ACTIVE=prod
