{
  "name": "engineering-ops-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "overrides": {
    "@redocly/openapi-core": "1.34.7",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5",
    "postcss": "8.5.23"
  },
  "scripts": {
    "dev": "npm run admin:dev",
    "build": "npm run admin:build",
    "prototype:dev": "cd prototypes/react && npm run dev",
    "gen:api": "bash ./scripts/gen-api-types.sh",
    "prototype:build": "cd prototypes/react && npm run build",
    "prototype:preview": "vite preview --host 0.0.0.0",
    "deps:install": "npm install --prefix apps/admin && npm install --prefix apps/mobile",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:preview": "npm --prefix apps/admin run preview",
    "mobile:dev": "npm --prefix apps/mobile run dev:h5",
    "mobile:dev:mp-weixin": "npm --prefix apps/mobile run dev:mp-weixin",
    "mobile:build": "npm --prefix apps/mobile run build:mp-weixin",
    "mobile:build:h5": "npm --prefix apps/mobile run build:h5",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile run test",
    "api:check": "bash scripts/check-backend.sh",
    "api:dev": "bash scripts/start-api.sh",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "tools:install": "bash scripts/install-local-tools.sh",
    "data:backup": "bash scripts/backup-data.sh",
    "test-bot": "node scripts/test-bot.js",
    "test-bot:fix": "node scripts/test-bot.js --fix",
    "preview": "npm run admin:preview",
    "test": "npm --prefix apps/admin run test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "npm --prefix apps/admin run lint",
    "format:check": "npm --prefix apps/admin run format:check",
    "version:check": "node scripts/version.mjs check",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "version:set": "node scripts/version.mjs set",
    "verify": "npm run lint && npm run format:check && npm run test && npm --prefix apps/admin run typecheck && npm run build && npm run mobile:typecheck && npm run mobile:test && npm run mobile:build:h5 && npm run mobile:build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.5.4",
    "vite": "8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "openapi-typescript": "^7.13.0"
  }
}
